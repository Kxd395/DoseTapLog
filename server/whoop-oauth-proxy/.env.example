# DoseTrack WHOOP OAuth2 Proxy - Environment Variables Template
# Copy this file to .env and fill in actual values
# NEVER commit .env to git - it contains sensitive credentials

# =============================================================================
# WHOOP OAuth2 Credentials
# =============================================================================
# Obtained from: https://developer.whoop.com/
# Registered: 2025-11-05
# See: docs/SECRETS.md for actual values

# Client ID (public, safe to share)
WHOOP_CLIENT_ID=your_client_id_here

# Client Secret (SENSITIVE - NEVER commit, backend only)
WHOOP_CLIENT_SECRET=your_client_secret_here

# =============================================================================
# Token Encryption
# =============================================================================
# Generate with: openssl rand -hex 32
# Used for AES-256-GCM encryption of access/refresh tokens at rest
# Rotate every 180 days or when team member leaves

ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# =============================================================================
# API Security
# =============================================================================
# Optional: Shared secret for iOS client authentication
# iOS app sends this via x-api-key header
# Rotate every 90 days or when device is lost

API_KEY=dosetrack-whoop-dev-2025

# =============================================================================
# WHOOP API Configuration
# =============================================================================
# Base URL for WHOOP API
# Production: https://api.prod.whoop.com
# Staging: https://api.staging.whoop.com (if available)

WHOOP_BASE=https://api.prod.whoop.com

# =============================================================================
# Server Configuration
# =============================================================================
# Port for local development (Railway/Cloud Functions override this)
PORT=3000

# Node environment
NODE_ENV=development

# =============================================================================
# Database Configuration (Future)
# =============================================================================
# Currently using in-memory Map for sessions
# TODO: Add PostgreSQL/Firestore for production
# DATABASE_URL=postgresql://user:pass@host:5432/dosetrack
# FIRESTORE_PROJECT_ID=dosetrack-prod

# =============================================================================
# Deployment Notes
# =============================================================================
# Railway:
#   railway variables set WHOOP_CLIENT_ID=...
#   railway variables set WHOOP_CLIENT_SECRET=...
#   railway variables set ENCRYPTION_KEY=$(openssl rand -hex 32)
#
# Google Cloud Functions:
#   gcloud functions deploy whoop-oauth-proxy \
#     --set-env-vars WHOOP_CLIENT_ID=...,WHOOP_CLIENT_SECRET=...,ENCRYPTION_KEY=...
#
# Heroku:
#   heroku config:set WHOOP_CLIENT_ID=...
#   heroku config:set WHOOP_CLIENT_SECRET=...
#   heroku config:set ENCRYPTION_KEY=$(openssl rand -hex 32)
