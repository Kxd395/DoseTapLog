{
  "name": "DoseTrack v1.1.1c Acceptance Criteria",
  "version": "1.0.0",
  "categories": {
    "clinical_safety": [
      {
        "id": "dose_per_min_max",
        "desc": "Per dose clamped 1.5 to 4.5 g",
        "must": true
      },
      {
        "id": "total_min_max",
        "desc": "Total nightly clamped 3.0 to 9.0 g",
        "must": true
      },
      {
        "id": "window_bounds",
        "desc": "Dose 2 between 150 and 240 minutes after Dose 1",
        "must": true
      },
      {
        "id": "rounding_policy",
        "desc": "0.25 g rounding only at display and save",
        "must": true
      },
      {
        "id": "ordering_guard",
        "desc": "Dose 2 cannot precede Dose 1",
        "must": true
      }
    ],
    "privacy": [
      {
        "id": "local_only",
        "desc": "No PHI leaves device",
        "must": true
      },
      {
        "id": "hk_read_only",
        "desc": "HealthKit Sleep read only, not persisted",
        "must": true
      }
    ],
    "server": [
      {
        "id": "auth_gate",
        "desc": "/api requires x-api-key",
        "must": true
      },
      {
        "id": "rate_limit",
        "desc": "60 requests per minute",
        "must": true
      },
      {
        "id": "pagination",
        "desc": "WHOOP range endpoints use limit 25 and nextToken",
        "must": true
      }
    ],
    "ios": [
      {
        "id": "utc_storage",
        "desc": "All timestamps stored UTC with timezoneOffsetMinutes captured",
        "must": true
      },
      {
        "id": "widget_intents",
        "desc": "AppIntents queue actions via App Group and app consumes on activation",
        "must": true
      },
      {
        "id": "csv_export",
        "desc": "CSV header and HH:mm formatting match spec",
        "must": true
      }
    ]
  }
}