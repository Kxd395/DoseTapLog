{
  "$id": "UnifiedHealthRecord",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "exporter_version",
    "source",
    "record_type",
    "start_utc",
    "end_utc",
    "service_day_key",
    "start_offset_min",
    "end_offset_min",
    "tz_name",
    "cutoff_hour_local",
    "sha256",
    "deleted"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version (e.g., 2.0)"
    },
    "exporter_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Exporter software version (e.g., 2.1.0)"
    },
    "source": {
      "type": "string",
      "enum": [
        "healthkit",
        "healthconnect",
        "apple_xml",
        "whoop"
      ]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "sleep",
        "hr",
        "hrv",
        "respiratory_rate",
        "spo2",
        "step"
      ]
    },
    "start_utc": {
      "type": "string",
      "format": "date-time"
    },
    "end_utc": {
      "type": "string",
      "format": "date-time"
    },
    "service_day_key": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD service day (cutoff-based bucketing)"
    },
    "start_offset_min": {
      "type": "integer",
      "description": "UTC offset in minutes at start timestamp (handles DST boundaries)"
    },
    "end_offset_min": {
      "type": "integer",
      "description": "UTC offset in minutes at end timestamp (handles DST boundaries)"
    },
    "tz_name": {
      "type": "string",
      "description": "IANA timezone identifier (e.g., America/New_York)"
    },
    "cutoff_hour_local": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23,
      "description": "Cutoff hour used for service-day bucketing (frozen per export)"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash over canonical tuple for dedupe"
    },
    "deleted": {
      "type": "boolean",
      "description": "True if this is a deletion tombstone (from HKAnchoredObjectQuery)"
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "description": "Numeric value (null for category types like sleep)"
    },
    "unit": {
      "type": "string",
      "enum": [
        "count/min",
        "ms",
        "pct",
        "count",
        "bpm"
      ],
      "description": "Normalized unit: count/min (hr, resp), ms (hrv), pct (spo2 0-100), count (steps)"
    },
    "device_model": {
      "type": "string",
      "description": "Device model (e.g., Apple Watch Series 8)"
    },
    "device_hw": {
      "type": "string",
      "description": "Device hardware version (stable identifier)"
    },
    "device_sw": {
      "type": "string",
      "description": "Device software version"
    },
    "source_app": {
      "type": "string",
      "description": "Source app bundle ID (e.g., com.apple.health)"
    },
    "metadata": {
      "type": "object",
      "description": "Type-specific metadata (e.g., sleep stage, nap_derived flag)"
    }
  }
}