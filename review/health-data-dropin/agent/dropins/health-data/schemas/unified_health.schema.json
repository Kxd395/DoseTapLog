{
  "$id": "UnifiedHealthRecord",
  "type": "object",
  "required": [
    "source",
    "record_type",
    "start_utc",
    "end_utc",
    "service_day_key",
    "local_offset_min",
    "tz_name",
    "record_id",
    "sha1"
  ],
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "healthkit",
        "healthconnect",
        "apple_xml"
      ]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "sleep",
        "hr",
        "hrv",
        "respiratory_rate",
        "spo2",
        "step",
        "nap"
      ]
    },
    "start_utc": {
      "type": "string",
      "format": "date-time"
    },
    "end_utc": {
      "type": "string",
      "format": "date-time"
    },
    "service_day_key": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD service day (noon cutoff)"
    },
    "local_offset_min": {
      "type": "integer",
      "description": "UTC offset in minutes at this timestamp"
    },
    "tz_name": {
      "type": "string",
      "description": "IANA timezone identifier (e.g., America/New_York)"
    },
    "record_id": {
      "type": "string",
      "description": "Unique record identifier for dedupe"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "SHA1 hash of record_id for fast dedupe"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (bpm, ms, %, count, etc.)"
    },
    "device": {
      "type": "string",
      "description": "Device name (e.g., Apple Watch Series 8)"
    },
    "source_app": {
      "type": "string",
      "description": "Source app bundle ID (e.g., com.apple.health)"
    },
    "metadata": {
      "type": "object"
    }
  }
}